# Task 2: Word Frequency Counter

sentence = "swift is fun and swift is fast"

# (a) Count total words
words = sentence.split()
print("Total Words:", len(words))

# (b) Find unique words
unique_words = set(words)
print("Unique Words:", sorted(unique_words))

# (c) Count each word's frequency
frequency = {}

for word in words:
    frequency[word] = frequency.get(word, 0) + 1

print("Word Frequencies:")

for word in sorted(frequency):
    print(f"{word}: {frequency[word]}")

# (d) Rank by frequency, ties alphabetically
ranked_words = sorted(
    frequency.items(),
    key=lambda item: (-item[1], item[0])
)

print("Ranked Words:")

for word, count in ranked_words:
    print(f"{word}: {count}")


