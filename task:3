
import Foundation

// ==========================================
// TASK 1: RESTAURANT BILL CALCULATOR
// ==========================================

print("===== TASK 1: RESTAURANT BILL =====")

let itemPrice = 450.0
let quantity = 3

// Calculate subtotal
let subtotal = itemPrice * Double(quantity)

// Coupon availability
let hasCoupon = true

// Calculate discount using ternary operator
let discount = (hasCoupon && subtotal > 1000)
    ? subtotal * 0.10
    : 0.0

// Calculate GST and total
let discountedAmount = subtotal - discount
let gst = discountedAmount * 0.18
let total = discountedAmount + gst

// Split bill among 4 people
let perPerson = total / 4.0

print("Item Price: ₹\(itemPrice)")
print("Quantity: \(quantity)")
print("Subtotal: ₹\(subtotal)")
print("Discount: ₹\(discount)")
print("GST: ₹\(gst)")
print("Total Bill: ₹\(total)")
print("Each Person Pays: ₹\(perPerson)")

