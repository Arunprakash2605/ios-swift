print("\n===== TASK 2: LEAP YEAR AND RANGE =====")

// Leap year expressions without if statements
let leap1900 = (1900 % 4 == 0 && 1900 % 100 != 0)
    || (1900 % 400 == 0)

let leap2000 = (2000 % 4 == 0 && 2000 % 100 != 0)
    || (2000 % 400 == 0)

let leap2024 = (2024 % 4 == 0 && 2024 % 100 != 0)
    || (2024 % 400 == 0)

let leap2026 = (2026 % 4 == 0 && 2026 % 100 != 0)
    || (2026 % 400 == 0)

print("1900 is leap year: \(leap1900)")
print("2000 is leap year: \(leap2000)")
print("2024 is leap year: \(leap2024)")
print("2026 is leap year: \(leap2026)")

// Check whether a number is between 1 and 100
